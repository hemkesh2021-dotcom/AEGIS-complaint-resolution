# Copy to .env; never commit real credentials.
AEGIS_API_KEY=replace-with-a-long-random-operator-key
AEGIS_LLM_PROVIDER=template
# nim | anthropic | openai | gemini | groq | openrouter | ollama | custom | template
# Set a model ID available to your chosen provider/account.
AEGIS_LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NIM_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
# Optional override including API version path, e.g. https://host.example/v1
AEGIS_LLM_BASE_URL=
AEGIS_LLM_API_KEY=
AEGIS_LLM_TIMEOUT_SECONDS=30
AEGIS_LLM_ALLOW_HTTP=false
ANTHROPIC_VERSION=2023-06-01

# Browser origins, rate limiting and retention policy.
AEGIS_ALLOWED_ORIGINS=http://localhost:8088
# AEGIS_INTAKE_RATE=20
# AEGIS_STATUS_RATE=60
# 0 keeps records indefinitely; choose a policy before using real customer data.
# AEGIS_RETENTION_DAYS=0
# AEGIS_TRUST_PROXY=false
# Local mail is captured by Mailpit; configure SPRING_MAIL_* for production.
# AEGIS_MAIL_ENABLED=true
# AEGIS_PUBLIC_BASE_URL=http://localhost:8088
# Legacy NIM model override remains supported.
# NIM_CHAT_MODEL=openai/gpt-oss-120b
